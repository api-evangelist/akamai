          "name": "Modify reputation analysis settings",
          "request": {
            "name": "Modify reputation analysis settings",
            "description": {
              "content": "__Kona Site Defender__ Toggle the `forwardToHTTPHeader` and `forwardSharedIPToHTTPHeaderAndSIEM` options. The `forwardToHTTPHeader` option adds client reputation details to requests forwarded to origin in an HTTP header. The `forwardSharedIPToHTTPHeaderAndSIEM` option adds a value indicating that shared IPs are included in HTTP header and SIEM integration when used.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configs",
                ":configId",
                "versions",
                ":versionNumber",
                "security-policies",
                ":policyId",
                "reputation-analysis"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "configId",
                  "description": "(Required) A unique identifier for each configuration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "versionNumber",
                  "description": "(Required) A unique identifier for each version of a configuration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "policyId",
                  "description": "(Required) A unique identifier for a security policy."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"forwardSharedIPToHTTPHeaderAndSIEM\": \"<boolean>\",\n  \"forwardToHTTPHeader\": \"<boolean>\"\n}",
              "options": {
