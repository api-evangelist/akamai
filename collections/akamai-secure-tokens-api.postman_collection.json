        {
          "id": "4c09b171-ec28-439d-bec7-a3e58a6522ce",
          "name": "Akamai Get a Secure Token",
          "request": {
            "name": "Akamai Get a Secure Token",
            "description": {
              "content": "__Deprecated__ Use the [Create a secure token](https://techdocs.akamai.com/edgeworkers/reference/post-secure-token) operation instead. This returns a generated authentication token, for use with enhanced debug headers for EdgeWorkers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "secure-token",
                ":propertyId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "acl",
                  "value": "/*",
                  "description": "Path prefix of the response pages to debug. This value can be a pattern that matches multiple pages, and is explicitly part of the final token. The default is `/*`. If you specify an `acl`, don't specify a `url`."
                },
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<uri>",
                  "description": "Exact path of the response pages to debug. This value is not explicitly part of the final token, but is used as a salt in the HMAC computation. If you specify a `url`, don't specify an `acl`."
                },
                {
                  "disabled": false,
                  "key": "expiry",
                  "value": "15",
                  "description": "Number of minutes before the authentication token expires, from a minute to an hour. The default is 15."
                },
                {
                  "disabled": false,
                  "key": "network",
                  "value": "<string>",
                  "description": "__Enum__ The network on which to use this authentication token, either `STAGING` or `PRODUCTION`. If not specified, the token is created for the network where the last property version activation occurred."
                },
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "propertyId",
                  "description": "(Required) Unique identifier for a property."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a319ca4a-1696-489d-b5b9-ac235ebc5cbb",
              "name": "A generated authentication token, for use with enhanced debug headers for EdgeWorkers. See [Enhanced debug headers](https://techdocs.akamai.com/edgeworkers/docs/enhanced-debug-header-details).",
              "originalRequest": {
                "url": {
                  "path": [
                    "secure-token",
                    ":propertyId"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "acl",
                      "value": "{{acl}}"
                    },
                    {
                      "key": "url",
                      "value": "{{url}}"
                    },
                    {
                      "key": "expiry",
                      "value": "{{expiry}}"
                    },
                    {
                      "key": "network",
                      "value": "{{network}}"
                    },
                    {
                      "key": "accountSwitchKey",
                      "value": "{{accountSwitchKey}}"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "propertyId",
                      "description": "(Required) Unique identifier for a property."
                    }
                  ]
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
