      "item": [
        {
          "id": "e12ea8cd-fff5-4c72-95b0-f43521b0025a",
          "name": "Akamai Create a Secure Token",
          "request": {
            "name": "Akamai Create a Secure Token",
            "description": {
              "content": "Generate a JWT authentication token to [enable enhanced debug headers](https://techdocs.akamai.com/edgeworkers/docs/enable-enhanced-debug-headers) for EdgeWorkers.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "secure-token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expiry\": 480,\n  \"hostname\": \"<string>\",\n  \"hostnames\": [\n    \"<string>\"\n  ],\n  \"propertyId\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "397e27d1-d267-47cd-8e61-6ca8eaaebbeb",
              "name": "A generated JWT authentication token, for use with enhanced debug headers for EdgeWorkers. See [Enhanced debug headers](https://techdocs.akamai.com/edgeworkers/docs/enhanced-debug-header-details).",
              "originalRequest": {
                "url": {
                  "path": [
                    "secure-token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "accountSwitchKey",
                      "value": "{{accountSwitchKey}}"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"expiry\": 30,\n  \"hostname\": \"www.example.com\",\n  \"propertyId\": \"123456789\",\n  \"hostnames\": [\n    \"www.hostname1.com\",\n    \"www.hostname2.com\"\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "Created",
              "code": 201,
