  "item": [
    {
      "id": "6f9fc389-07df-4803-bd46-75a3674ebe0f",
      "name": "Configuration: Evaluation hostnames",
      "description": {
        "content": "Manage hostnames you're currently evaluating for a configuration\nversion.  If using Web Application Protector, manage hostnames\ncurrently in evaluation mode.  This mode lets you to see how\nyour configuration settings protect a hostname's traffic before\nadding the hostname to a live configuration.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "d40ad9d4-b308-4a92-a1c6-d2e651f17bd3",
          "name": "Protect evaluation hostnames",
          "request": {
            "name": "Protect evaluation hostnames",
            "description": {
              "content": "__Web Application Protector__, __App & API Protector__ Move hostnames you're evaluating to active protection. When you move a hostname from the evaluation hostnames list, it's added to your security policy as a protected hostname. You'll see that hostname in the response object the next time you run [List selected hostnames](https://techdocs.akamai.com/application-security/reference/get-selected-hostnames).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configs",
                ":configId",
                "versions",
                ":versionNumber",
                "protect-eval-hostnames"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "configId",
                  "description": "(Required) A unique identifier for each configuration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "versionNumber",
                  "description": "(Required) A unique identifier for each version of a configuration."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hostnames\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"mode\": \"<string>\"\n}",
              "options": {
