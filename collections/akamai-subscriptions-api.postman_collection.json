  "item": [
    {
      "id": "75563703-bab2-4fa5-a18f-a24a68199939",
      "name": "Subscriptions",
      "description": {
        "content": "Manage the email subscriptions for features within a specific\nsecurity configuration.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "2d4743a3-44f0-4075-bc64-28c75c92f60e",
          "name": "Subscribe or unsubscribe to recommendation emails",
          "request": {
            "name": "Subscribe or unsubscribe to recommendation emails",
            "description": {
              "content": "__Kona Site Defender__ Set the request object's `action` to `subscribe` to add user emails to the subscription object. Use `unsubscribe` to remove them from the list. The lists are organized by `features`. Currently available `feature` values are `AAG_TUNING_REC` for AAG and ASE rule sets, and `WAF_RULE_UPDATE` for ASE rule sets.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configs",
                ":configId",
                "notification",
                "subscription",
                ":feature"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "feature",
                  "description": "(Required) A unique identifier for each subscription feature."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "configId",
                  "description": "(Required) A unique identifier for each configuration."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/problem+json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"<string>\",\n  \"emails\": [\n    \"<string>\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "93ea927a-731f-438b-bbc8-bf87b0b1a853",
              "name": "Subscribed/Unsubscribed successfully.",
