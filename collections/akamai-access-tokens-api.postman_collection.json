                    {
                      "key": "accountSwitchKey",
                      "value": "{{accountSwitchKey}}"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"allowOnProduction\": false,\n  \"allowOnStaging\": true,\n  \"expiry\": \"2021-09-30\",\n  \"name\": \"my_token\",\n  \"namespacePermissions\": {\n    \"marketing\": [\n      \"r\",\n      \"w\"\n    ]\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
