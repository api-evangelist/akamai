        {
          "id": "97a55f20-aba9-4f17-98cf-e2e79a978197",
          "name": "Get a discovered API",
          "request": {
            "name": "Get a discovered API",
            "description": {
              "content": "__All products__ Returns details about an API discovered in account traffic. It is identified based on hostname and basepath.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api-discovery",
                "host",
                ":hostname",
                "basepath",
                ":basePath"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "includeHidden",
                  "value": "false",
                  "description": "If `true`, includes all discovered APIs including ones you have hidden. By default, `false` returns only the visible APIs."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Filter results by name, description, or ID. You can match on substrings."
                },
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "hostname",
                  "description": "(Required) The base64-encoded value of the hostname."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "basePath",
                  "description": "(Required) The base64-encoded value of the base path."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
