      "id": "10db0599-2b1c-4c91-b506-e62b5cba7b14",
      "name": "Custom rule actions",
      "description": {
        "content": "Manage the actions contained in your custom rules.  Use custom\nrules to handle scenarios not covered by the included standard\nrules or to quickly patch new website vulnerabilities.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "25a23d08-4d88-4452-b1f0-3e87c070008e",
          "name": "List custom rule actions",
          "request": {
            "name": "List custom rule actions",
            "description": {
              "content": "__All products__ Returns a list of all configured custom rules for the specified configuration. It includes information for rules that are associated with this policy, as well as the latest versions of the rules in the configuration that aren't associated with the current policy. Unassociated rules have an action of `none`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "configs",
                ":configId",
                "versions",
                ":versionNumber",
                "security-policies",
                ":policyId",
                "custom-rules"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountSwitchKey",
                  "value": "<string>",
                  "description": "For customers who manage more than one account, this [runs the operation from another account](https://techdocs.akamai.com/developer/docs/manage-many-accounts-with-one-api-client). The Identity and Access Management API provides a [list of available account switch keys](https://techdocs.akamai.com/iam-api/reference/get-client-account-switch-keys)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "configId",
                  "description": "(Required) A unique identifier for each configuration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "versionNumber",
                  "description": "(Required) A unique identifier for each version of a configuration."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "policyId",
                  "description": "(Required) A unique identifier for a security policy."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
